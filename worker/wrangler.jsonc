{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-prime-api",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // Bucket R2 des fiches et commentaires, créé dans la juridiction Union européenne (données de stagiaires).
  "r2_buckets": [
    { "binding": "OUTILS", "bucket_name": "claude-prime-outils", "jurisdiction": "eu" }
  ],

  // Adresse : claude-prime-api.<sous-domaine>.workers.dev, protégée en entier par Cloudflare Access.
  // Plus tard, un domaine personnalisé permettra de ne protéger que /edition/* :
  // "routes": [{ "pattern": "outils-api.example.fr", "custom_domain": true }],

  "vars": {
    // Origine autorisée à lire /api/* depuis un navigateur.
    "ORIGINE_PUBLIQUE": "https://scap-mehdi.github.io",
    // Dossier publié par GitHub Pages. Le Worker y lit outils.html pour /edition/outils.html.
    "PAGE_SOURCE": "https://scap-mehdi.github.io/claude-prime/",
    // Cloudflare Access. Vides : toute modification est refusée (503).
    // Ce ne sont pas des secrets : le domaine d'équipe et l'AUD identifient l'application Access.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
